{
  "name": "template",
  "version": "0.1.0",
  "description": "模板插件：演示生命周期、命令注册与 Context 宿主能力",
  "author": "your-name",
  "entry": "dist/index.js",
  "ui": {
    "title": "模板页",
    "entry": "ui/index.html"
  },
  "widgets": [
    {
      "id": "hello.count",
      "type": "number",
      "title": "问候次数",
      "prominence": "secondary",
      "stale": 30
    },
    {
      "id": "hello.level",
      "type": "gauge",
      "title": "活跃度",
      "unit": "%",
      "max": 100,
      "prominence": "normal",
      "warn": 70,
      "danger": 90,
      "stale": 30
    }
  ],
  "配置声明": {
    "说明": "模板插件的配置示例。改动后立即生效，插件用 ctx.配置() 读取。",
    "字段": [
      {
        "键": "prefix",
        "标题": "命令前缀",
        "类型": "string",
        "默认值": "/",
        "说明": "识别聊天命令时使用的前缀。"
      },
      {
        "键": "enabled",
        "标题": "启用回应",
        "类型": "boolean",
        "默认值": true,
        "说明": "关闭后插件仍然加载，但不再回应命令。"
      },
      {
        "键": "greeting",
        "标题": "打招呼语",
        "类型": "string",
        "提示": "你好",
        "说明": "`/hello` 命令回复的文本。"
      }
    ]
  }
}
