{
  "name": "kugua-studio",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "苦瓜工作室：本地知识库管理及模块化自动操作平台",
  "workspaces": [
    "packages/*",
    "packages/modules/*"
  ],
  "scripts": {
    "build": "node scripts/sync-modules.mjs && npm run build --workspace @kugua/module-image --if-present && node scripts/gen-image-defaults.mjs && npm run build --workspaces --if-present",
    "gen:image-defaults": "node scripts/gen-image-defaults.mjs",
    "start": "npm run build -w @kugua/webui && npm run start -w @kugua/webui",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run --passWithNoTests",
    "test:ui": "npm run test:ui -w @kugua/webui",
    "main": "node packages/main/dist/index.js",
    "mcp": "node packages/mcp/dist/bin.js",
    "webui": "npm run build -w @kugua/webui && npm run start -w @kugua/webui",
    "sync:modules": "node scripts/sync-modules.mjs",
    "check:modules": "node scripts/sync-modules.mjs --check",
    "ai": "node packages/modules/ai/dist/index.js",
    "av": "node packages/modules/av/dist/index.js",
    "avatar": "node packages/modules/avatar/dist/index.js",
    "calendar": "node packages/modules/calendar/dist/index.js",
    "chatmode": "node packages/modules/chatmode/dist/index.js",
    "dice": "node packages/modules/dice/dist/index.js",
    "divination": "node packages/modules/divination/dist/index.js",
    "dream": "node packages/modules/dream/dist/index.js",
    "echo": "node packages/modules/echo/dist/index.js",
    "food": "node packages/modules/food/dist/index.js",
    "image": "node packages/modules/image/dist/index.js",
    "infotool": "node packages/modules/infotool/dist/index.js",
    "job": "node packages/modules/job/dist/index.js",
    "mcp-client": "node packages/modules/mcp-client/dist/index.js",
    "mkg": "node packages/modules/mkg/dist/index.js",
    "monitor": "node packages/modules/monitor/dist/index.js",
    "music": "node packages/modules/music/dist/index.js",
    "napcat": "node packages/modules/napcat/dist/index.js",
    "nlp": "node packages/modules/nlp/dist/index.js",
    "plugins": "node packages/modules/plugins/dist/index.js",
    "proof": "node packages/modules/proof/dist/index.js",
    "qrcode": "node packages/modules/qrcode/dist/index.js",
    "scheduler": "node packages/modules/scheduler/dist/index.js",
    "text": "node packages/modules/text/dist/index.js",
    "translate": "node packages/modules/translate/dist/index.js",
    "tts": "node packages/modules/tts/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
