{
  "name": "sysmon",
  "version": "1.0.0",
  "description": "系统监控：CPU / 内存 / GPU 小组件",
  "author": "kugua",
  "entry": "index.js",
  "配置声明": {
    "说明": "采样频率与 GPU 开关。默认值适合大多数机器。",
    "字段": [
      {
        "键": "intervalMs",
        "标题": "采样间隔（毫秒）",
        "类型": "number",
        "默认值": 1500,
        "最小": 500,
        "最大": 10000,
        "步进": 100,
        "说明": "CPU 与内存的采样间隔。低于 1 秒人眼看不出差别，只增加开销。",
        "生效": "立即"
      },
      {
        "键": "gpu",
        "标题": "采集 GPU",
        "类型": "boolean",
        "默认值": true,
        "说明": "通过 nvidia-smi 读取显卡使用率。启动时探测一次，探不到就永久放弃并隐藏该组件——不会留下永远「无数据」的卡片。",
        "生效": "立即"
      },
      {
        "键": "gpuIntervalMs",
        "标题": "GPU 采样间隔（毫秒）",
        "类型": "number",
        "默认值": 6000,
        "最小": 2000,
        "最大": 60000,
        "步进": 500,
        "说明": "nvidia-smi 单次约 0.2 秒，不宜高频。GPU 使用率本来就是慢变量，6 秒足够。",
        "生效": "立即"
      }
    ]
  },
  "widgets": [
    {
      "id": "cpu",
      "type": "gauge",
      "title": "CPU",
      "unit": "%",
      "max": 100,
      "prominence": "primary",
      "warn": 70,
      "danger": 90,
      "stale": 15
    },
    {
      "id": "mem",
      "type": "gauge",
      "title": "内存",
      "unit": "%",
      "max": 100,
      "prominence": "primary",
      "warn": 80,
      "danger": 92,
      "stale": 15
    }
  ]
}
