{
  "name": "@kugua/module-job",
  "version": "0.1.0",
  "type": "module",
  "description": "作业运行时：以子进程执行脚本/爬虫等长任务，支持日志流、超时、取消、历史",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@kugua/capability": "*",
    "@kugua/nigane": "*",
    "@kugua/module-kit": "*"
  },
  "kugua": {
    "module": true,
    "autoStart": true,
    "description": "作业运行时：脚本/爬虫等长任务，日志流/超时/取消/历史"
  }
}
