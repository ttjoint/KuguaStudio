{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "moduleResolution": "node",
    "strict": true,
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/renderer/**/*.ts"]
}
