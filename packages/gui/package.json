{
  "name": "@kugua/gui",
  "version": "0.5.0",
  "type": "module",
  "description": "苦瓜工作室本地 GUI（Electron）",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && npm run copy-assets",
    "copy-assets": "node -e \"import('node:fs/promises').then(async fs=>{await fs.copyFile('src/renderer/index.html','dist/renderer/index.html');await fs.copyFile('src/renderer/style.css','dist/renderer/style.css');await fs.copyFile('dist/preload.js','dist/preload.cjs');await fs.mkdir('dist/assets',{recursive:true});await fs.copyFile('src/assets/icon.jpg','dist/assets/icon.jpg')})\"",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev"
  },
  "dependencies": {
    "@kugua/nigane": "*",
    "electron": "^32.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  }
}
