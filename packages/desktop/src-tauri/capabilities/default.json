{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口所需的最小权限：仅窗口控制，不开放文件系统/网络/进程能力",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "quit-app",
    "show-window",
    "minimize-window",
    "toggle-maximize",
    "is-maximized"
  ]
}
